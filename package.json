{
  "name": "dockclock",
  "private": true,
  "version": "0.1.0",
  "description": "WhatsApp-first detention evidence and clause-gated claims for small trucking fleets, on AWS Communication Developer Services.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services",
    "infra",
    "site"
  ],
  "scripts": {
    "typecheck": "tsc -b && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "scorecard": "node --conditions=source --import tsx packages/clause-engine/src/cli/scorecard.ts",
    "fixtures:write": "node --conditions=source --import tsx packages/clause-engine/src/cli/write-fixtures.ts",
    "smoke:lifecycle": "node --env-file-if-exists=.env --conditions=source --import tsx scripts/smoke-lifecycle.ts",
    "synth": "npm run synth -w @dockclock/infra",
    "deploy": "tsc -b && npm run deploy -w @dockclock/infra",
    "templates:submit": "node --env-file-if-exists=.env --conditions=source --import tsx scripts/submit-templates.ts",
    "live:dispatch": "node --env-file-if-exists=.env --conditions=source --import tsx scripts/dispatch-live.ts",
    "live:watch": "node --env-file-if-exists=.env --conditions=source --import tsx scripts/watch-load.ts",
    "demo:facility": "node --env-file-if-exists=.env --conditions=source --import tsx scripts/demo-facility.ts",
    "rcs:two-way": "node --env-file-if-exists=.env --conditions=source --import tsx scripts/rcs-two-way.ts",
    "smoke:rcs": "node --env-file-if-exists=.env --conditions=source --import tsx scripts/smoke-rcs.ts",
    "bol:photos": "node --conditions=source --import tsx scripts/bol-photos.ts",
    "diagram": "node --import tsx scripts/render-architecture.ts",
    "verify:pack": "node --conditions=source --import tsx scripts/verify-pack.ts",
    "eval:bol": "node --env-file-if-exists=.env --conditions=source --import tsx scripts/eval-bol.ts",
    "agent:run": "node --env-file-if-exists=.env --conditions=source --import tsx scripts/agent-run.ts",
    "approve:load": "node --env-file-if-exists=.env --conditions=source --import tsx scripts/approve-load.ts",
    "desk:snapshot": "node --env-file-if-exists=.env --conditions=source --import tsx scripts/desk-snapshot.ts",
    "backfill:workspace": "node --env-file-if-exists=.env --conditions=source --import tsx scripts/backfill-workspace.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-lambda": "^3.1152.0",
    "@aws-sdk/client-scheduler": "^3.1152.0",
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^9.39.5",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  }
}
