%% DockClock architecture. Rendered to architecture.svg / architecture.png by scripts/render-architecture.ts.
flowchart TB
  subgraph phones["Phones"]
    JDG["Judge's phone<br/>texts DEMO: capped demo load,<br/>plays driver and dispatcher"]
    DSP["Dispatcher phone<br/>WhatsApp"]
    DRV["Driver phone<br/>WhatsApp, RCS fallback"]
  end

  EUMS["AWS End User Messaging Social<br/>WhatsApp templates, location pins,<br/>Flows, photo media"]
  EUMR["AWS End User Messaging<br/>SMS-Voice v2: RCS agent"]
  SNS["Amazon SNS<br/>WhatsApp + RCS event topics"]
  SQS["Amazon SQS ingest queue"]
  DLQ["SQS dead-letter queue<br/>+ CloudWatch alarm"]
  ING["Ingest Lambda<br/>one DynamoDB transaction per event:<br/>dedupe + timeline + outbox"]
  SEC["AWS Secrets Manager<br/>phone to driver id key"]
  DDB[("DynamoDB single table<br/>loads, timeline, outbox, claims")]
  MEDIA[("S3 media bucket<br/>photos, SHA-256 hashed")]
  DISP["Dispatch Lambda<br/>starts a load for the carrier or a DEMO,<br/>sends the load template"]

    S1(["1 Await Arrived pin<br/>2 Schedule notice"])
    S3(["3 Await Released pin<br/>4 Await bill-of-lading Flow"])
    S5(["5 Read bill of lading<br/>calls the Tools Lambda directly"])
    S7(["Ask driver for a clearer photo<br/>WhatsApp Flow, once"])
    subgraph seal[" "]
      SEALP["6 Seal evidence Lambda<br/>hash photos, build pack, sign, lock"]
      CE["Clause engine: code decides<br/>BILLABLE / NOT_BILLABLE / NEEDS_HUMAN"]
    end
    V{"Verdict?"}
    AP(["7 Ask dispatch to approve<br/>Approve / Hold template<br/>waitForTaskToken"])
    FC(["8 Agent files the claim"])
    CC(["9 Check claim record<br/>workflow reads it itself"])
    NH(["Email dispatch:<br/>needs a person"])
    NB(["Close: not billable"])

  SCH["Amazon EventBridge Scheduler<br/>one-time schedule,<br/>fires before free time ends"]
  NOT["Send notice Lambda<br/>emails the detention notice;<br/>driver gets dockclock_notice_sent"]
  LOCK[("S3 Object Lock bucket<br/>signed evidence packs")]
  KMS["AWS KMS<br/>ECDSA P-256 signing key"]

  subgraph model[" "]
    TAGM["<b>Model reads and drafts</b>"]
    HAR["Amazon Bedrock AgentCore Harness<br/>Claude Sonnet 4.5 on Bedrock"]
  end

  subgraph decide[" "]
    TAGD["<b>Code and Cedar decide</b>"]
    GW["AgentCore Gateway<br/>MCP, IAM auth"]
    CED["Cedar policy engine<br/>ENFORCE, default deny"]
    TOOLS["Tools Lambda<br/>get_load_evidence<br/>read_bill_of_lading: Bedrock vision<br/>send_detention_claim: amount and<br/>digest must equal the sealed pack"]
  end

  SES["Amazon SES<br/>configuration set dockclock-claims<br/>domain claims.kaungzinhein.com"]
  INBOX["Broker / shipper inbox<br/>notice, then claim + signed pack"]
  DINBOX["Dispatch inbox<br/>needs a person, Talk to dispatch"]

  JDG -->|DEMO| EUMS
  DSP <--> EUMS
  DRV <--> EUMS
  DRV <-.->|fallback| EUMR
  EUMS --> SNS
  EUMR --> SNS
  SNS --> SQS
  SQS -.->|5 failures| DLQ
  SQS --> ING
  ING --- SEC
  ING --> DDB
  ING -->|photos| MEDIA
  ING -->|DEMO| DISP
  DISP -->|StartExecution| S1
  ING -.->|taps and pins resume each wait| S3

  S1 --> S3 --> S5
  S5 -->|not legible, first time| S7
  S7 -->|new photo| S5
  S5 -->|legible, or after one retake| SEALP
  SEALP --> CE --> V
  V -->|BILLABLE| AP
  V -->|NOT_BILLABLE| NB
  V -->|NEEDS_HUMAN| NH
  AP -->|Approve tap| FC --> CC

  S1 --> SCH --> NOT
  %% Invisible links keep the notice path and the NEEDS_HUMAN branch beside the steps they belong to.
  SCH ~~~ S5
  NOT ~~~ SEALP
  NH ~~~ FC

  SEALP -->|Sign| KMS
  SEALP -->|put pack| LOCK

  FC --> HAR
  HAR -->|MCP tool calls| GW
  GW -->|authorize every call| CED
  GW --> TOOLS
  TOOLS -->|claim + signed pack| SES
  NOT -->|notice| SES
  NH --> SES
  SES --> INBOX
  SES --> DINBOX

  classDef person fill:#fff7e6,stroke:#b7791f,color:#1a202c
  classDef aws fill:#eef4ff,stroke:#3b5bdb,color:#1a202c
  classDef step fill:#f1f3f5,stroke:#495057,color:#1a202c
  classDef store fill:#e6fcf5,stroke:#0ca678,color:#1a202c
  classDef decideNode fill:#ebfbee,stroke:#2f9e44,stroke-width:2px,color:#1a202c
  classDef modelNode fill:#f3f0ff,stroke:#7048e8,stroke-width:2px,color:#1a202c
  class DRV,DSP,JDG,INBOX,DINBOX person
  class EUMS,EUMR,SNS,SQS,DLQ,ING,DISP,SCH,NOT,SES,SEALP aws
  class S1,S3,S5,S7,V,AP,FC,CC,NH,NB step
  class DDB,SEC,MEDIA,KMS,LOCK store
  class CE,GW,CED,TOOLS decideNode
  class HAR modelNode
  classDef tagModel fill:none,stroke:none,color:#5f3dc4,font-size:19px
  classDef tagDecide fill:none,stroke:none,color:#2b8a3e,font-size:19px
  class TAGM tagModel
  class TAGD tagDecide
  style model fill:#faf8ff,stroke:#7048e8,stroke-width:2px
  style decide fill:#f6fcf7,stroke:#2f9e44,stroke-width:2px
  style seal fill:#f6fcf7,stroke:#2f9e44
