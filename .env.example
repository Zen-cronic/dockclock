AWS_PROFILE=hackathon-1
AWS_REGION=us-east-1
DOCKCLOCK_ACCOUNT=111122223333
DOCKCLOCK_REGION=us-east-1
DOCKCLOCK_WHATSAPP_TOPIC_ARN=arn:aws:sns:us-east-1:111122223333:your-whatsapp-events-topic
DOCKCLOCK_ORIGINATION_PHONE_ID=phone-number-id-0123456789abcdef
DOCKCLOCK_META_WABA_ID=0000000000000000
DOCKCLOCK_META_PHONE_ID=0000000000000000
DOCKCLOCK_META_API_VERSION=v23.0
DOCKCLOCK_DRIVER_REPLIES=off
DOCKCLOCK_DRIVER_ALLOWLIST=+15550100000
DOCKCLOCK_SES_TEST_RECIPIENTS=you+broker@example.com,you+shipper@example.com
DOCKCLOCK_RELEASE_FLOW_ID=0000000000000000
DOCKCLOCK_FLOW_MODE=draft
DOCKCLOCK_DISPATCH_EMAIL=dispatch@example.com
DOCKCLOCK_FROM_EMAIL=dockclock@example.com
